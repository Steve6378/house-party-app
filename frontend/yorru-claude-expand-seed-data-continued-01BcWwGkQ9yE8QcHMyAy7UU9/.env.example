# Yorru Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it contains secrets!)

# Database
DATABASE_URL=postgresql://yorru_dev:your_password@localhost/yorru_dev

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-key-here

# JWT Secret (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your-random-secret-key-here

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (True for dev, False for production)
DEBUG=True
