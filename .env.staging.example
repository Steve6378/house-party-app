# Yorru Staging Environment Configuration
# Copy this file to .env.staging and fill in your Railway staging database URL
# Use for testing production-like settings without affecting live users

# Database (Railway Staging Database URL)
DATABASE_URL=postgresql://railway_staging_user:password@staging.railway.app:5432/railway

# OpenAI API Key (same as dev, or separate key for tracking staging usage)
OPENAI_API_KEY=sk-your-openai-key-here

# JWT Secret (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your-random-secret-key-here

# Environment (staging - will disable DEBUG)
ENVIRONMENT=staging

# Debug mode (False for staging to match production behavior)
DEBUG=False
